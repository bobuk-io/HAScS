# Release facts of HAScS for the shared kit in Scripts/release (see Scripts/release/README.md).
APP_NAME=HAScS
BUNDLE_ID=io.bobuk.HAScS
# Copies installed before the identifier change.
LEGACY_BUNDLE_IDS=com.bobuk.HAScS
ARCHIVE_PREFIX=HAScS
CHECKSUMS_FILE=SHA256SUMS.txt
INSTALL_DIR=/Applications
GITHUB_REPO=bobuk-io/HAScS
LANDING_SLUG=hascs
BUNDLE_CHECK=Scripts/check_bundle.swift
EXTRA_TESTS='bash Vendor/BobukKit/Scripts/check-vendor.sh'
# Packaging with Scripts/release/package.sh (see Scripts/release/README.md, "Packaging").
PACKAGE_REFUSE_RUNNING=1
